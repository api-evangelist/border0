{
  "opencollection": "1.0.0",
  "info": {
    "name": "Border0 Audit Actions Login API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Login",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Refresh API token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.border0.com/api/v1/login/refresh",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Refresh API token"
        },
        {
          "info": {
            "name": "User login",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.border0.com/api/v1/login",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "User login"
        }
      ]
    }
  ],
  "bundled": true
}