{
  "opencollection": "1.0.0",
  "info": {
    "name": "Border0 Audit Actions Organization API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Organization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a custom identity provider for the current organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.border0.com/api/v1/organization/identity_provider/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Identity provider name"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Get a custom identity provider for the current organization"
        },
        {
          "info": {
            "name": "Remove a custom identity provider from the current organization",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.border0.com/api/v1/organization/identity_provider/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Identity provider name"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Remove a custom identity provider from the current organization"
        },
        {
