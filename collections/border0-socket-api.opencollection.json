            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.border0.com/api/v1/socket/:socket_id_or_name/tunnel/:tunnel_id",
            "params": [
              {
                "name": "socket_id_or_name",
                "value": "",
                "type": "path",
                "description": "Socket ID or Name that the tunnel is associated with"
              },
              {
                "name": "tunnel_id",
                "value": "",
                "type": "path",
                "description": "Tunnel ID"
              }
            ],
